{
	"extends": "$app/tsconfig",
	"include": ["src", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"paths": {
			"firstly": ["./src/lib"],
			"firstly/*": ["./src/lib/*"]
		},
		"experimentalDecorators": true,
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"declaration": false
	}
}
